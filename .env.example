APP_NAME="Jiloul Jadid"
APP_ENV=production
APP_DEBUG=false
APP_KEY=
# Générer avec : docker compose run --rm --no-deps --entrypoint php app -r "echo 'base64:'.base64_encode(random_bytes(32));"

APP_URL=https://jilouljadid.com
FRONTEND_URL=https://jilouljadid.com
ASSET_URL=https://jilouljadid.com

SESSION_DRIVER=redis
SESSION_DOMAIN=jilouljadid.com
SANCTUM_STATEFUL_DOMAINS=jilouljadid.com,www.jilouljadid.com

DB_DATABASE=jilouljadid
DB_USERNAME=jilouljadid
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

REVERB_APP_ID=jilouljadid
REVERB_APP_KEY=CHANGE_ME_REVERB_KEY
REVERB_APP_SECRET=CHANGE_ME_REVERB_SECRET
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

NEXT_PUBLIC_SITE_URL=https://jilouljadid.com
NEXT_PUBLIC_API_URL=https://jilouljadid.com/api/v1
NEXT_PUBLIC_WS_URL=wss://jilouljadid.com/ws
NEXT_PUBLIC_ADMIN_URL=https://jilouljadid.com/institut/administration

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@jilouljadid.com
MAIL_FROM_NAME="Jiloul Jadid"

# Certificats SSL sur le VPS (après certbot)
LETSENCRYPT_PATH=/etc/letsencrypt
